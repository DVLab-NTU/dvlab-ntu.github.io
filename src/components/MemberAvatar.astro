---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const { src, alt, large = false, position = 'center' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/public/**/*.{jpg,jpeg,png,webp}', { eager: true });
const image = images[`/public${src}`]?.default;
if (!image) throw new Error(`Member avatar must be a local raster image: ${src}`);
---
<Image src={image} alt={alt} width={320} widths={[160, 320, 640]}
  sizes={large ? '(max-width: 640px) 84px, 104px' : '46px'} format="webp" quality={80}
  style={{ objectPosition: position }}
  class={`member-avatar${large ? ' member-avatar-lg' : ''}`}
  loading={large ? 'eager' : 'lazy'} decoding="async" />
