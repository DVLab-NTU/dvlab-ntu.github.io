---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  href?: string;
  /** Non-link cards (awards): subtle hover without link color shift */
  static?: boolean;
  class?: string;
}

const { href, static: isStatic, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag
  class:list={[
    'glass-list-card',
    isStatic && 'glass-list-card--static',
    className,
  ]}
  href={href}
  {...rest}
>
  <slot />
</Tag>
