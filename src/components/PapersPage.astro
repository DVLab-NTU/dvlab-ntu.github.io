---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pageCopy } from '../data/page-copy.mjs';

const paperEntries = await getCollection('papers');
const papers = paperEntries
  .map((e) => ({ slug: e.slug, ...e.data }))
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.papers[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
---
<BaseLayout title={t.title} desc={t.description} lang={lang} pathPrefix={pathPrefix}>
  <section class="page-head" data-reveal>
    <h1 class="page-title">{t.title}</h1>
    <p>{t.intro}</p>
  </section>

  <section class="filter-wrap" data-list-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-list-search
      placeholder={t.placeholder}
      aria-label={t.search}
    />
    <p class="empty-state" data-empty-state hidden>{t.empty}</p>

    <div class="grid project-grid" data-list-intro>
      {papers.map((p, i) => (
        <a
          href={`${pathPrefix}/papers/${p.slug}/`}
          class="card card-hover card-link stack-sm"
          data-list-intro-item
          {...(i < 8 ? { 'data-list-intro-active': true } : {})}
          data-list-card
          data-search-text={`${p.title} ${p.authors || ''} ${p.venue} ${p.year}`}
        >
          <h3>{p.title}</h3>
          <p>{p.venue}</p>
          {p.authors && <p class="paper-authors">{t.authors}{p.authors}</p>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
