---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pickI18nText } from '../utils/i18n-text';
import { pageCopy } from '../data/page-copy.mjs';
import { formatAwardDateChip } from '../utils/award-date.mjs';
import GlassListCard from './glass/GlassListCard.astro';
import GlassMetaChip from './glass/GlassMetaChip.astro';
import GlassMetaRow from './glass/GlassMetaRow.astro';

const awardEntries = await getCollection('awards');
const awards = awardEntries
  .map((e) => ({ slug: e.slug, ...e.data }))
  .sort((a, b) => b.year - a.year || a.month.localeCompare(b.month));
const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.awards[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
---
<BaseLayout title={t.title} desc={t.description} lang={lang} pathPrefix={pathPrefix}>
  <div class="awards-cra">
  <section class="page-head" data-reveal>
    <h1 class="page-title cra-page-title">{t.title}</h1>
  </section>

  <section class="glass-list glass-list--grid award-list" data-reveal-group>
    {awards.map((a, i) => (
      <GlassListCard
        id={a.slug}
        class="award-list-item"
        static
        data-reveal
        data-reveal-order={String(i)}
      >
        <h3 class="glass-list-card__title">{pickI18nText(a.title, lang)}</h3>
        <GlassMetaRow>
          <GlassMetaChip value={formatAwardDateChip(a.month, a.year)} />
          <a
            slot="actions"
            class="btn btn-ghost award-source"
            href={a.source}
            target="_blank"
            rel="noreferrer"
          >{t.source}</a>
        </GlassMetaRow>
        <p class="glass-list-card__detail award-list-detail">
          <strong>{t.students}</strong>{a.students.join(t.separator)}
        </p>
        {a.advisors && a.advisors.length > 0 && (
          <p class="glass-list-card__detail award-list-detail">
            <strong>{t.advisors}</strong>{a.advisors.join(t.separator)}
          </p>
        )}
      </GlassListCard>
    ))}
  </section>
  </div>
</BaseLayout>
