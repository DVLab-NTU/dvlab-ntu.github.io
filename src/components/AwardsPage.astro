---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pickI18nText } from '../utils/i18n-text';
import { pageCopy } from '../data/page-copy.mjs';

const awardEntries = await getCollection('awards');
const awards = awardEntries
  .map((e) => ({ slug: e.slug, ...e.data }))
  .sort((a, b) => b.year - a.year || a.month.localeCompare(b.month));
const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.awards[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
---
<BaseLayout title={t.title} desc={t.description} lang={lang} pathPrefix={pathPrefix}>
  <div class="awards-cra">
  <section class="page-head" data-reveal>
    <h1 class="page-title cra-page-title">{t.title}</h1>
  </section>

  <section class="award-list" data-reveal-group>
    {awards.map((a, i) => (
      <article id={a.slug} class="award-list-item" data-reveal data-reveal-order={String(i)}>
        <h3>{pickI18nText(a.title, lang)}</h3>
        <div class="detail-meta award-list-meta">
          <span class="badge-muted paper-meta-chip">
            <span class="paper-chip-label">{t.yearLabel}</span>
            <span class="paper-chip-value">{a.year}</span>
          </span>
          <span class="badge-muted paper-meta-chip">
            <span class="paper-chip-label">{t.monthLabel}</span>
            <span class="paper-chip-value">{a.month}</span>
          </span>
        </div>
        <p class="award-list-detail">
          <strong>{t.students}</strong>{a.students.join(t.separator)}
        </p>
        {a.advisors && a.advisors.length > 0 && (
          <p class="award-list-detail">
            <strong>{t.advisors}</strong>{a.advisors.join(t.separator)}
          </p>
        )}
        <div class="award-list-actions">
          <a class="btn btn-ghost award-source" href={a.source} target="_blank" rel="noreferrer">{t.source}</a>
        </div>
      </article>
    ))}
  </section>
  </div>
</BaseLayout>
