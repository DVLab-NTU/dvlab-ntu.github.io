---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { summarizeParts } from '../utils/seo';
import { displayVenue } from '../utils/paper-meta.mjs';
import { pageCopy } from '../data/page-copy.mjs';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.paper[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const { entry } = Astro.props;
const abstract = entry.data.abstract?.trim() ?? '';
const bibtex = entry.data.bibtex?.trim() ?? '';
const hasBody = Boolean(entry.body?.trim());
const venueName = displayVenue(entry.data.venue, entry.data.year);
const { Content } = await render(entry);
const pageDesc = abstract || summarizeParts([entry.data.authors, entry.data.venue, entry.data.year], 160);
---
<BaseLayout title={entry.data.title} desc={pageDesc} lang={lang} pathPrefix={pathPrefix} ogType="article">
  <div class="papers-cra">
  <section class="detail-shell">
    <article class="card detail-hero" data-reveal>
      <h1 class="page-title">{entry.data.title}</h1>
      <div class="detail-meta paper-detail-meta">
        {venueName && (
          <span class="badge paper-meta-chip">
            <span class="paper-chip-label">{t.venueLabel}</span>
            <span class="paper-chip-value">{venueName}</span>
          </span>
        )}
        <span class="badge-muted paper-meta-chip">
          <span class="paper-chip-label">{t.yearLabel}</span>
          <span class="paper-chip-value">{entry.data.year}</span>
        </span>
      </div>
      {entry.data.authors && <p class="paper-authors">{t.authors}{entry.data.authors}</p>}
    </article>

    {abstract && (
      <article class="card detail-section" data-reveal>
        <h2>{t.abstract}</h2>
        <p>{abstract}</p>
      </article>
    )}

    {bibtex && (
      <article class="card detail-section" data-reveal>
        <h2>{t.citation}</h2>
        <div class="detail-links paper-detail-actions">
          <details class="bibtex-details">
            <summary class="btn btn-ghost bibtex-summary">{t.bibtex}</summary>
            <pre id={`bibtex-${entry.slug}`}><code>{bibtex}</code></pre>
          </details>
          <button
            class="btn btn-ghost copy-btn"
            type="button"
            data-copy-target={`bibtex-${entry.slug}`}
            data-copy-label={t.copy}
            data-copy-success={t.copied}
          >
            {t.copy}
          </button>
        </div>
      </article>
    )}

    {hasBody && (
      <article class="card detail-content" data-reveal>
        <Content />
      </article>
    )}
  </section>
  </div>
</BaseLayout>
