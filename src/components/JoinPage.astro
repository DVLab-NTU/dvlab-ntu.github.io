---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { summarizeText } from '../utils/seo';
import { pageCopy } from '../data/page-copy.mjs';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.join[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const joinEntries = await getCollection('join');
const entry = joinEntries.find(item => item.id === `recruitment/overview_${lang === 'zh' ? 'cn' : 'en'}.md`);
if (!entry) throw new Error(`Missing recruitment content for ${lang}`);

const { Content } = await render(entry);
const pageTitle = entry.data.title || (lang === 'zh' ? '招生與合作' : 'Recruitment & Collaboration');
const pageDesc = summarizeText(entry.body) || (lang === 'zh' ? '檢視 DVLab 的招生與合作資訊。' : 'Explore recruitment and collaboration information for DVLab.');
---
<BaseLayout title={pageTitle} desc={pageDesc} lang={lang} pathPrefix={pathPrefix}>
  <section class="detail-shell">
    <article class="card detail-hero" data-reveal>
      <h1 class="page-title">{pageTitle}</h1>
    </article>

    <article class="card detail-content news-article" data-reveal>
      <Content />
    </article>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={`${pathPrefix}/`}>{t.home}</a>
      <a class="btn btn-ghost" href={`${pathPrefix}/members/`}>{t.members}</a>
    </div>
  </section>
</BaseLayout>
