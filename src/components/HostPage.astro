---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { pageCopy } from '../data/page-copy.mjs';
import { pickI18nText } from '../utils/i18n-text';
import { HOST_MEMBER_ID, HOST_PHOTO, hostLineUrl } from '../utils/host-member';
import HostSocialSquareIcon from './HostSocialSquareIcon.astro';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.host[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const entry = await getEntry('members', HOST_MEMBER_ID);
if (!entry) {
  throw new Error(`Missing host member content: ${HOST_MEMBER_ID}`);
}
const member = entry.data;
const nameText = lang === 'zh' ? `${member.name.zh} 教授` : `Professor ${member.name.en}`;
const bio = pickI18nText(member.bio, lang);
const paragraphs = bio ? bio.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
const links = member.links;
const pageDesc = paragraphs[0]?.slice(0, 160) || t.description;

const socialItems = [
  links?.email && { key: 'email', href: `mailto:${links.email}`, label: t.email, variant: 'email' as const },
  links?.linkedin && { key: 'linkedin', href: links.linkedin, label: 'LinkedIn', variant: 'linkedin' as const },
  links?.facebook && { key: 'facebook', href: links.facebook, label: 'Facebook', variant: 'facebook' as const },
  { key: 'line', href: hostLineUrl, label: 'LINE', variant: 'line' as const },
  links?.homepage && { key: 'homepage', href: links.homepage, label: t.homepage, variant: 'homepage' as const },
].filter(Boolean);
---
<BaseLayout title={t.title} desc={pageDesc} lang={lang} pathPrefix={pathPrefix}>
  <div class="host-cra" data-reveal>
    <div class="host-cra-wrapper">
      <h1 class="host-cra-title">{nameText}</h1>
      <p class="host-cra-tagline" lang={lang === 'zh' ? 'zh-TW' : 'en'}>&ldquo;{t.tagline}&rdquo;</p>

      <div class="host-content-info">
        <div class="host-left-col">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <aside class="host-right-col" aria-label={t.photoLabel}>
          <div class="host-photo-wrap">
            <img
              class="host-photo"
              src={HOST_PHOTO}
              alt={member.name[lang]}
              width="739"
              height="739"
              loading="eager"
              decoding="async"
            />
          </div>
          <ul class="host-social host-social-cra" aria-label={t.socialLabel}>
            {socialItems.map((item) => (
              <li>
                <a
                  class="host-social-link host-social-link-square"
                  href={item.href}
                  target={item.key === 'email' ? undefined : '_blank'}
                  rel={item.key === 'email' ? undefined : 'noreferrer'}
                  aria-label={item.label}
                >
                  <HostSocialSquareIcon variant={item.variant} uid={item.key} />
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>

      <div class="host-cra-actions">
        <a class="btn btn-primary" href={`${pathPrefix}/members/`}>{t.members}</a>
        <a class="btn btn-ghost" href={`${pathPrefix}/`}>{t.home}</a>
      </div>
    </div>
  </div>
</BaseLayout>
