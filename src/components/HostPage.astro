---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberAvatar from './MemberAvatar.astro';
import { getEntry } from 'astro:content';
import { pageCopy } from '../data/page-copy.mjs';
import { roles } from '../data/member-labels.mjs';
import { resolveMemberAvatar } from '../utils/member-avatar';
import { pickI18nText } from '../utils/i18n-text';
import { HOST_MEMBER_ID, hostLineUrl } from '../utils/host-member';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const t = pageCopy.host[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const entry = await getEntry('members', HOST_MEMBER_ID);
if (!entry) {
  throw new Error(`Missing host member content: ${HOST_MEMBER_ID}`);
}
const member = entry.data;
const nameText = lang === 'zh' ? `${member.name.zh} 教授` : `Professor ${member.name.en}`;
const bio = pickI18nText(member.bio, lang);
const paragraphs = bio ? bio.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
const links = member.links;
const pageDesc = paragraphs[0]?.slice(0, 160) || t.description;
---
<BaseLayout title={t.title} desc={pageDesc} lang={lang} pathPrefix={pathPrefix}>
  <section class="host-page" data-reveal>
    <header class="host-header">
      <p class="section-label">{t.eyebrow}</p>
      <h1 class="page-title host-title">{nameText}</h1>
      <p class="host-tagline" lang={lang === 'zh' ? 'zh-TW' : 'en'}>&ldquo;{t.tagline}&rdquo;</p>
    </header>

    <div class="host-body">
      <div class="host-copy card host-copy-panel">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="host-role-note">
          <span class="badge">{roles[member.role][lang]}</span>
        </p>
      </div>

      <aside class="host-aside card" aria-label={t.photoLabel}>
        <MemberAvatar src={resolveMemberAvatar(member)} alt={member.name[lang]} large />
        <ul class="host-social" aria-label={t.socialLabel}>
          {links?.email && (
            <li>
              <a class="host-social-link" href={`mailto:${links.email}`} aria-label={t.email}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2 8 5 8-5v2l-8 5-8-5V6Zm16 12V9.2l-8 5-8-5V18h16Z" /></svg>
              </a>
            </li>
          )}
          {links?.linkedin && (
            <li>
              <a class="host-social-link" href={links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.8-3-1.9 0-2.2 1.5-2.2 3V21h-4V9Z" /></svg>
              </a>
            </li>
          )}
          {links?.facebook && (
            <li>
              <a class="host-social-link" href={links.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3h4a1 1 0 0 1 1 1v3h3a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-3v7a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-7H8a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h3V7.5C10 4.5 11.5 3 13 3Z" /></svg>
              </a>
            </li>
          )}
          <li>
            <a class="host-social-link" href={hostLineUrl} target="_blank" rel="noreferrer" aria-label="LINE">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 3h-15A3.5 3.5 0 0 0 1 6.5v7A3.5 3.5 0 0 0 4.5 17H6v3.5a.5.5 0 0 0 .8.4L12.7 17h6.8A3.5 3.5 0 0 0 23 13.5v-7A3.5 3.5 0 0 0 19.5 3ZM8 10.5H6.5a.5.5 0 0 1-.5-.5V8a.5.5 0 0 1 1 0v1.5H8a.5.5 0 0 1 0 1Zm3.5 0h-1a.5.5 0 0 1-.5-.5V8a.5.5 0 0 1 1 0v1.5h.5a.5.5 0 0 1 0 1Zm4 0h-1a.5.5 0 0 1-.5-.5V8.3l-1.2 1.9a.5.5 0 0 1-.8 0L11.8 8.3V10a.5.5 0 0 1-1 0V8a.5.5 0 0 1 .9-.3l1.6 2.4 1.6-2.4a.5.5 0 0 1 .9.3v2a.5.5 0 0 1-.5.5h-1Z" /></svg>
            </a>
          </li>
          {links?.homepage && (
            <li>
              <a class="host-social-link" href={links.homepage} target="_blank" rel="noreferrer" aria-label={t.homepage}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 2 7v2h20V7L12 2Zm0 4.2 6.5 3.25V11H5.5V9.45L12 6.2ZM4 13h16v9H4v-9Zm2 2v5h12v-5H6Z" /></svg>
              </a>
            </li>
          )}
        </ul>
      </aside>
    </div>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={`${pathPrefix}/members/`}>{t.members}</a>
      <a class="btn btn-ghost" href={`${pathPrefix}/`}>{t.home}</a>
    </div>
  </section>
</BaseLayout>
