---
import { Image } from 'astro:assets';
import chip from '../assets/legacy-logo/chip.png';
import bug from '../assets/legacy-logo/bug.png';
import magnifier from '../assets/legacy-logo/magnifier.png';
import ntugiee from '../assets/legacy-logo/ntugiee.png';
import name from '../assets/legacy-logo/dvlab_text.png';
import description from '../assets/legacy-logo/description.png';
const { lang } = Astro.props as { lang: 'zh' | 'en' };
const layers = [
  { src: chip, x: 28.833, y: 8.125, width: 31.667, delay: 0 },
  { src: bug, x: 32.667, y: 18.438, width: 10, delay: 220 },
  { src: magnifier, x: 24.333, y: 0, width: 23.833, delay: 420 },
  { src: ntugiee, x: 38, y: 7.813, width: 45, delay: 700 },
  { src: name, x: 17, y: 67.5, width: 65, delay: 950 },
  { src: description, x: 0, y: 86.25, width: 100, delay: 1200 },
];
---
<div class="home-logo" data-home-logo>
  <div class="logo-art" role="img" aria-label={lang === 'zh'
    ? '台大電機設計驗證實驗室：放大鏡檢視晶片上的小蟲'
    : 'Design Verification Lab, NTUEE: a magnifying glass inspecting a bug on a chip'}>
    {layers.map(layer => <Image src={layer.src} alt="" aria-hidden="true"
      width={Math.min(layer.src.width, Math.round(1800 * layer.width / 100))} format="webp" quality={90}
      loading="eager" decoding="async" class="logo-layer"
      style={`left:${layer.x}%;top:${layer.y}%;width:${layer.width}%;--delay:${layer.delay}ms`} />)}
  </div>
  <div class="logo-controls">
    <button type="button" class="logo-replay" hidden>{lang === 'zh' ? '重播動畫' : 'Replay animation'}</button>
  </div>
</div>
<script>
  import '../scripts/home-logo.mjs';
</script>
<style>
  .home-logo { width: 100%; max-width: 960px; }
  .logo-art { position: relative; width: 100%; aspect-ratio: 60 / 32; }
  .logo-layer { position: absolute; height: auto; opacity: 1; }
  .is-playing .logo-layer { animation: logo-enter 600ms ease-out var(--delay) both; }
  .logo-controls { height: 32px; display: grid; place-items: center; }
  .logo-replay { border: 0; padding: 4px 12px; background: transparent; color: #f2e7a2; font: inherit; font-size: 0.8rem; cursor: pointer; border-radius: 4px; }
  .logo-replay:hover { text-decoration: underline; }
  .logo-replay:focus-visible { outline: 2px solid #f2e7a2; outline-offset: 2px; }
  .logo-replay[hidden] { display: none; }
  @keyframes logo-enter { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .is-playing .logo-layer { animation: none; }
    .logo-replay { display: none; }
  }
</style>
