---
import { Image } from 'astro:assets';
import chip from '../assets/legacy-logo/chip.png';
import bug from '../assets/legacy-logo/bug.png';
import magnifier from '../assets/legacy-logo/magnifier.png';
import ntugiee from '../assets/legacy-logo/ntugiee.png';
import name from '../assets/legacy-logo/dvlab_text.png';
import description from '../assets/legacy-logo/description.png';
const { lang } = Astro.props as { lang: 'zh' | 'en' };
const layers = [
  { part: 'chip', src: chip, x: 28.833, y: 8.125, width: 31.667, delay: 0 },
  { part: 'bug', src: bug, x: 32.667, y: 18.438, width: 10, delay: 220 },
  { part: 'magnifier', src: magnifier, x: 24.333, y: 0, width: 23.833, delay: 420 },
  { part: 'text', src: ntugiee, x: 38, y: 7.813, width: 45, delay: 700 },
  { part: 'text', src: name, x: 17, y: 67.5, width: 65, delay: 950 },
  { part: 'text', src: description, x: 0, y: 86.25, width: 100, delay: 1200 },
];
---
<div class="home-logo" data-home-logo>
  <button class="logo-art" type="button" disabled aria-label={lang === 'zh'
    ? '重播實驗室 Logo 動畫：放大鏡檢視晶片上的小蟲'
    : 'Replay the lab logo animation: a magnifying glass inspecting a bug on a chip'}>
    {layers.map(layer => <Image src={layer.src} alt="" aria-hidden="true"
      width={Math.min(layer.src.width, Math.round(1800 * layer.width / 100))} format="webp" quality={90}
      loading="eager" decoding="async" class="logo-layer" data-logo-part={layer.part}
      style={`left:${layer.x}%;top:${layer.y}%;width:${layer.width}%;--delay:${layer.delay}ms`} />)}
  </button>
</div>
<script>
  import '../scripts/home-logo.mjs';
</script>
<style>
  .home-logo { width: 100%; max-width: 960px; }
  .logo-art { display: block; position: relative; width: 100%; aspect-ratio: 60 / 32; padding: 0; border: 0; background: transparent; color: inherit; opacity: 1; }
  .logo-art:enabled { cursor: pointer; }
  .logo-art:focus-visible { outline: 2px solid currentColor; outline-offset: 8px; border-radius: 12px; }
  :global([data-theme='light']) [data-logo-part='text'] { filter: brightness(0) opacity(0.85); }
  :global([data-theme='light']) [data-logo-part='chip'] { filter: brightness(1.8) saturate(0.55); }
  .logo-layer { position: absolute; height: auto; opacity: 1; }
  .is-playing .logo-layer { animation: logo-enter 600ms ease-out var(--delay) both; }
  @keyframes logo-enter { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .is-playing .logo-layer { animation: none; }
  }
</style>
