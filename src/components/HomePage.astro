---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteEn from '../data/site.en.json';
import siteZh from '../data/site.zh.json';
import { getCollection } from 'astro:content';
import HomeLogo from './HomeLogo.astro';
import { pageCopy } from '../data/page-copy.mjs';
import { pickI18nText } from '../utils/i18n-text';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const labels = pageCopy.home[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const t = lang === 'en' ? siteEn : siteZh;
const awards = (await getCollection('awards'))
  .map((entry) => ({ slug: entry.slug, ...entry.data }))
  .sort((a, b) => b.year - a.year || a.month.localeCompare(b.month))
  .slice(0, 6);
---
<BaseLayout title="" desc={t.home.intro} lang={lang} pathPrefix={pathPrefix}>
  <div class="home-cra">
    <section class="home-opening" aria-label={lang === 'zh' ? '實驗室開場動畫' : 'Lab introduction animation'}>
      <canvas class="home-particles" data-particles aria-hidden="true"></canvas>
      <HomeLogo lang={lang} />
    </section>

    <section id="lab-introduction" class="home-news" aria-labelledby="home-news-title">
      <div class="home-news-inner">
        <h2 id="home-news-title">{labels.newsAwards}</h2>
        {awards.map((award) => (
          <a class="home-news-item" href={`${pathPrefix}/awards/#${award.slug}`}>
            <div class="home-news-date">
              <span>{award.year}</span><br />
              <span>{award.month}</span>
            </div>
            <div>
              <h3 class="home-news-title">{pickI18nText(award.title, lang)}</h3>
              <p class="home-news-meta">{award.students.join(labels.awardSeparator)}</p>
            </div>
          </a>
        ))}
        <p class="home-news-more">
          <a href={`${pathPrefix}/awards/`}>{labels.allAwards} <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>

    <section class="home-intro-band" aria-labelledby="home-title">
      <div class="container">
        <h1 id="home-title" class="page-title cra-page-title">{labels.heading}</h1>
        <p>{t.home.intro}</p>
        <div class="home-intro-links">
          <a href={`${pathPrefix}/host/`}>{labels.hostCta}</a>
          <a href={`${pathPrefix}/members/`}>{labels.allMembers}</a>
          <a href={`${pathPrefix}/papers/`}>{labels.allPapers}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/particles.mjs';
</script>

<style>
  .home-particles { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; }
  .home-opening {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: clamp(24px, 4vw, 48px) clamp(12px, 3vw, 40px);
    color: #f4f8ff;
  }
  .home-news-more {
    margin: 8px 0 0;
    font-weight: 600;
  }
  .home-news-more a {
    color: var(--cra-dark-blue);
    text-decoration: none;
  }
  .home-news-more a:hover {
    text-decoration: underline;
  }
</style>
