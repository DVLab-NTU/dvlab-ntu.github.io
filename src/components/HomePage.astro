---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteEn from '../data/site.en.json';
import siteZh from '../data/site.zh.json';
import { getCollection } from 'astro:content';
import HomeLogo from './HomeLogo.astro';
import { pageCopy } from '../data/page-copy.mjs';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const labels = pageCopy.home[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const t = lang === 'en' ? siteEn : siteZh;
const photos = await getCollection('life');
const hero = photos.find(entry => entry.slug === 'group-hiking')?.data;
if (!hero) throw new Error('Missing group-hiking activity for home hero');
---
<BaseLayout title="" desc={t.home.intro} lang={lang} pathPrefix={pathPrefix}>
  <section class="home-opening mb-5" aria-label={lang === 'zh' ? '實驗室開場動畫' : 'Lab introduction animation'}>
    <p class="opening-label">DESIGN VERIFICATION LAB · NTUEE</p>
    <HomeLogo lang={lang} />
  </section>

  <section id="lab-introduction" class="home-introduction mb-5" aria-labelledby="home-title">
    <div class="intro-copy">
      <h1 id="home-title" class="hero-title">{t.siteName}</h1>
      <p class="hero-subtitle">{t.home.intro}</p>
    </div>
    <div class="lab-photo">
      <img class="lab-photo-img" src={hero.photo} alt={hero.alt[lang]}
        loading="lazy" decoding="async" width="1400" height="1050" />
      <span class="lab-photo-caption">{hero.caption[lang]}</span>
    </div>
  </section>

  <section class="mb-5">
    <div class="page-head" data-reveal>
      <h2 class="page-title">{t.home.sections?.highlights ?? 'Highlights'}</h2>
    </div>
    <div class="grid grid-3" data-reveal-group>
      {t.home.highlights.map((h, i) => (
        <article class="card card-hover card-clickable" data-reveal data-reveal-order={String(i)}>
          <a class="card-link-overlay" href={`${pathPrefix}${h.href}`} aria-label={`${labels.view} ${h.title}`}></a>
          <h3>{h.title}</h3>
          <p class="mt-4">{h.desc}</p>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .home-opening {
    min-height: 80vh;
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: clamp(24px, 4vw, 48px) clamp(12px, 3vw, 40px);
    border-radius: 24px;
    background: radial-gradient(ellipse at 50% 42%, #294961, #14263a 80%);
    color: #f4f8ff;
  }
  .opening-label { margin: 0; font-size: 0.75rem; letter-spacing: 0.18em; text-align: center; color: #b8cdd6; }
  :global([data-theme='light']) .home-opening {
    background: radial-gradient(ellipse at 50% 42%, #fdfeea, #e8efbc 85%);
    color: #293515;
  }
  :global([data-theme='light']) .opening-label { color: #536337; }
  .home-introduction { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; padding-block: 32px; scroll-margin-top: 140px; }
  .home-introduction .hero-title { margin-top: 0; }
  .home-introduction .lab-photo { margin: 0; }
  @media (max-width: 700px) {
    .home-introduction { grid-template-columns: minmax(0, 1fr); }
    .home-opening { border-radius: 16px; }
  }
</style>
