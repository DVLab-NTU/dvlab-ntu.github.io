---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteEn from '../data/site.en.json';
import siteZh from '../data/site.zh.json';
import { getCollection } from 'astro:content';
import HomeLogo from './HomeLogo.astro';
import { pageCopy } from '../data/page-copy.mjs';
import { pickI18nText } from '../utils/i18n-text';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const labels = pageCopy.home[lang];
const awardLabels = pageCopy.awards[lang];
const pathPrefix = lang === 'en' ? '/en' : '';
const t = lang === 'en' ? siteEn : siteZh;
const awards = (await getCollection('awards'))
  .map((entry) => ({ slug: entry.slug, ...entry.data }))
  .sort((a, b) => b.year - a.year || a.month.localeCompare(b.month));

function awardAttendants(award: { students: string[]; advisors?: string[] }) {
  const people = [...award.students];
  if (award.advisors?.length) people.push(...award.advisors);
  return people.join(labels.awardSeparator);
}
---
<BaseLayout title="" desc={t.home.intro} lang={lang} pathPrefix={pathPrefix}>
  <div class="home-cra">
    <section class="home-opening" aria-label={lang === 'zh' ? '實驗室開場動畫' : 'Lab introduction animation'}>
      <canvas class="home-particles" data-particles aria-hidden="true"></canvas>
      <HomeLogo lang={lang} />
    </section>

    <section id="lab-introduction" class="home-news" aria-labelledby="home-news-title">
      <div class="home-news-inner">
        <h1 id="home-news-title" class="section-title home-news-heading">{labels.newsAwards}</h1>
        <div class="home-news-list">
          {awards.map((award) => (
            <article class="home-news-item">
              <div class="home-news-date">
                <div class="home-news-date-chip">
                  <span class="home-news-date-year">{award.year}</span>
                  <span class="home-news-date-month">{award.month}</span>
                </div>
              </div>
              <div class="home-news-detail">
                <h3 class="home-news-title">{pickI18nText(award.title, lang)}</h3>
                <p class="home-news-meta">{awardAttendants(award)}</p>
                <a
                  class="btn btn-ghost home-news-source-link"
                  href={award.source}
                  target="_blank"
                  rel="noreferrer"
                >
                  {awardLabels.source}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/particles.mjs';
</script>
