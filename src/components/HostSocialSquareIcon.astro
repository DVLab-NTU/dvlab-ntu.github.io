---
/**
 * CRA HostProfile square brand tiles (Font Awesome 6 square-* / linkedin family).
 * Light tile with glyph knocked out via mask (panel color shows through).
 */
type Variant = 'email' | 'linkedin' | 'facebook' | 'line' | 'homepage';

const { variant, uid } = Astro.props as { variant: Variant; uid: string };

const maskId = `host-social-mask-${uid}-${variant}`;

/** Glyph paths only (24×24 user space), centered in a 48×48 tile. */
const glyphs: Record<Variant, { d: string; transform: string }> = {
  email: {
    transform: 'translate(12 14)',
    d: 'M20 4H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z',
  },
  linkedin: {
    transform: 'translate(13 12)',
    d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.8-3-1.9 0-2.2 1.5-2.2 3V21h-4V9z',
  },
  facebook: {
    transform: 'translate(15 10)',
    d: 'M13 3h4a1 1 0 0 1 1 1v3h3a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-3v7a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-7H8a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h3V7.5C10 4.5 11.5 3 13 3z',
  },
  line: {
    transform: 'translate(8 14)',
    d: 'M19.5 3h-15A3.5 3.5 0 0 0 1 6.5v7A3.5 3.5 0 0 0 4.5 17H6v3.5a.5.5 0 0 0 .8.4L12.7 17h6.8A3.5 3.5 0 0 0 23 13.5v-7A3.5 3.5 0 0 0 19.5 3zM8 10.5H6.5a.5.5 0 0 1-.5-.5V8a.5.5 0 0 1 1 0v1.5H8a.5.5 0 0 1 0 1zm3.5 0h-1a.5.5 0 0 1-.5-.5V8a.5.5 0 0 1 1 0v1.5h.5a.5.5 0 0 1 0 1zm4 0h-1a.5.5 0 0 1-.5-.5V8.3l-1.2 1.9a.5.5 0 0 1-.8 0L11.8 8.3V10a.5.5 0 0 1-1 0V8a.5.5 0 0 1 .9-.3l1.6 2.4 1.6-2.4a.5.5 0 0 1 .9.3v2a.5.5 0 0 1-.5.5h-1z',
  },
  homepage: {
    transform: 'translate(12 12)',
    d: 'M10.59 2.59a2 2 0 0 0-2.83 0L2.7 7.66A1 1 0 0 0 3 9h1v11a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9h1a1 1 0 0 0 .3-.74l-5.06-5.07a2 2 0 0 0-2.65-.6zM12 4.41 14.59 7H12V4.41z',
  },
};

const glyph = glyphs[variant];
---

<svg class="host-social-square-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <defs>
    <mask id={maskId}>
      <rect width="48" height="48" fill="white" rx="10" />
      <g transform={glyph.transform}>
        <path fill="black" d={glyph.d} />
      </g>
    </mask>
  </defs>
  <rect width="48" height="48" rx="10" fill="var(--host-social-tile)" mask={`url(#${maskId})`} />
</svg>
