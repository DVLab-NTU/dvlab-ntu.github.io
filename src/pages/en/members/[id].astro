---
import Page from '../../../components/MemberPage.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('members')).map(entry => ({ params: { id: entry.data.id }, props: { member: entry.data } }));
}
---
<Page lang="en" member={Astro.props.member} />
