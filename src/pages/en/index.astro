---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteEn from '../../data/site.en.json';
import particlesScript from '../../scripts/particles.mjs?url';

const t = siteEn;
const highlightLinks = ['/en/members/', '/en/papers/', '/en/join/'];
---
<BaseLayout title="" desc={t.home.intro} lang="en" pathPrefix="/en">
  <section class="hero mb-5" data-reveal>
    <canvas class="hero-particles" data-particles aria-hidden="true"></canvas>
    <div class="hero-inner">
      <h1 class="hero-title" data-reveal data-reveal-delay="70">{t.siteName}</h1>
      <p class="hero-subtitle" data-reveal data-reveal-delay="120">{t.home.intro}</p>
      <div class="lab-photo">
        <img
          class="lab-photo-img"
          src="/images/lab/group-hiking.jpg"
          alt="DVLab group photo during a hiking activity"
          loading="eager"
          decoding="async"
          width="1400"
          height="1050"
        />
        <span class="lab-photo-caption">Lab hiking trip</span>
      </div>
      <div class="hero-actions" data-reveal data-reveal-delay="180">
        <a class="btn btn-primary" href="/en/members/">Meet the Team</a>
        <a class="btn btn-primary" href="/en/papers/">Publications</a>
        <a class="btn btn-primary" href="/en/courses/">Courses</a>
        <a class="btn btn-primary" href="/en/awards/">Awards</a>
      </div>
    </div>
  </section>

  <section class="mb-5">
    <div class="page-head" data-reveal>
      <h2 class="page-title">{t.home.sections?.highlights ?? 'Highlights'}</h2>
    </div>
    <div class="grid grid-3" data-reveal-group>
      {t.home.highlights.map((h, i) => (
        <article class="card card-hover card-clickable" data-reveal data-reveal-order={String(i)}>
          <a class="card-link-overlay" href={highlightLinks[i] ?? '/en/news'} aria-label={`View ${h.title}`}></a>
          <h3>{h.title}</h3>
          <p class="mt-4">{h.desc}</p>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
