---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteZh from '../data/site.zh.json';
import particlesScript from '../scripts/particles.mjs?url';

const t = siteZh;
const highlightLinks = ['/members/', '/papers/', '/join/'];
---
<BaseLayout title="" desc={t.home.intro} lang="zh" pathPrefix="">
  <section class="hero mb-5" data-reveal>
    <canvas class="hero-particles" data-particles aria-hidden="true"></canvas>
    <div class="hero-inner">
      <h1 class="hero-title" data-reveal data-reveal-delay="70">{t.siteName}</h1>
      <p class="hero-subtitle" data-reveal data-reveal-delay="120">{t.home.intro}</p>
      <div class="lab-photo">
        <img
          class="lab-photo-img"
          src="/images/lab/group-hiking.jpg"
          alt="DVLab 實驗室登山合照"
          loading="eager"
          decoding="async"
          width="1400"
          height="1050"
        />
        <span class="lab-photo-caption">實驗室登山活動</span>
      </div>
      <div class="hero-actions" data-reveal data-reveal-delay="180">
        <a class="btn btn-primary" href="/members/">了解成員</a>
        <a class="btn btn-primary" href="/papers/">檢視論文</a>
        <a class="btn btn-primary" href="/courses/">檢視課程</a>
        <a class="btn btn-primary" href="/awards/">獲獎紀錄</a>
      </div>
    </div>
  </section>

  <section class="mb-5">
    <div class="page-head" data-reveal>
      <h2 class="page-title">{t.home.sections?.highlights ?? '重點資訊'}</h2>
    </div>
    <div class="grid grid-3" data-reveal-group>
      {t.home.highlights.map((h, i) => (
        <article class="card card-hover card-clickable" data-reveal data-reveal-order={String(i)}>
          <a class="card-link-overlay" href={highlightLinks[i] ?? '/news'} aria-label={`檢視 ${h.title} 詳情`}></a>
          <h3>{h.title}</h3>
          <p class="mt-4">{h.desc}</p>
        </article>
      ))}
    </div>
  </section>

  /BaseLayout>
