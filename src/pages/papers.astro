---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const paperEntries = await getCollection('papers');
const papers = paperEntries
  .map((e) => ({ slug: e.slug, ...e.data }))
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const pageDesc = '檢視 DVLab 論文列表與發表資訊。';
---
<BaseLayout title="論文" desc={pageDesc} lang="zh" pathPrefix="">
  <section class="page-head" data-reveal>
    <h1 class="page-title">論文</h1>
  </section>

  <section class="filter-wrap" data-list-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-list-search
      placeholder="搜尋標題 / 作者 / 會議 / 年份..."
      aria-label="搜尋論文"
    />
    <p class="empty-state" data-empty-state hidden>沒有匹配論文，請調整關鍵詞。</p>

    <div class="grid project-grid" data-list-intro>
      {papers.map((p, i) => (
        <a
          href={`/papers/${p.slug}/`}
          class="card card-hover card-link stack-sm"
          data-list-intro-item
          {...(i < 8 ? { 'data-list-intro-active': true } : {})}
          data-list-card
          data-search-text={`${p.title} ${p.authors || ''} ${p.venue} ${p.year}`}
        >
          <h3>{p.title}</h3>
          <p>{p.year} · {p.venue}</p>
          {p.authors && <p class="paper-authors">作者：{p.authors}</p>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
