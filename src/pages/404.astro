---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404"
  desc="DVLab 找不到這個頁面。"
  lang="zh"
  pathPrefix=""
  noindex={true}
  disableCanonical={true}
  disableLocaleAlternates={true}
>
  <section class="detail-shell">
    <article class="card detail-hero" data-reveal>
      <span class="badge-muted">404</span>
      <h1 class="page-title">頁面不存在</h1>
      <p>這個頁面不存在，可能已經移除或換了網址。</p>
    </article>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href="/">返回首頁</a>
      <a class="btn btn-ghost" href="/host/">主持人</a>
      <a class="btn btn-ghost" href="/members/">成員</a>
      <a class="btn btn-ghost" href="/papers/">論文</a>
      <a class="btn btn-ghost" href="/courses/">課程</a>
      <a class="btn btn-ghost" href="/awards/">獲獎</a>
    </div>
  </section>
</BaseLayout>
