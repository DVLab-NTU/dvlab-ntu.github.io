---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildLocalizedNews } from '../utils/news-localized';

const newsEntries = await getCollection('news');
const news = newsEntries.length === 0 ? [] : buildLocalizedNews(newsEntries).filter((item) => item.entry.zh);
const pageDesc = 'DVLab（台大設計驗證實驗室）最新消息與活動公告：研究進展、競賽捷報、招生資訊與實驗室動態。';
---
<BaseLayout title="新聞" desc={pageDesc} lang="zh" pathPrefix="">
  <section class="page-head" data-reveal>
    <h1 class="page-title">新聞動態</h1>
  </section>

  <section class="filter-wrap" data-list-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-list-search
      placeholder="搜尋新聞標題 / 日期 / 關鍵詞..."
      aria-label="搜尋新聞"
    />
    <p class="empty-state" data-empty-state hidden>沒有匹配新聞，請調整關鍵詞。</p>

    <div class="grid" data-list-intro>
      {news.map((n, i) => (
        <a
          href={`/news/${n.slug}/`}
          class="card card-hover card-link stack-sm"
          data-list-intro-item
          {...(i < 8 ? { 'data-list-intro-active': true } : {})}
          data-list-card
          data-search-text={`${n.title.zh || ''} ${n.title.en || ''} ${n.date || ''} ${n.slug}`}
        >
          <h3>{n.title.zh || n.title.en || n.slug}</h3>
          {n.date && <p>{n.date}</p>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
