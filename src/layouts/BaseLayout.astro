---
import siteZh from '../data/site.zh.json';
import siteEn from '../data/site.en.json';
import { ClientRouter } from 'astro:transitions';
import { buildDefaultLocaleAlternates, normalizeSitePath, toAbsoluteUrl } from '../utils/seo';
import type { LocaleAlternates } from '../utils/seo';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/effects.css';
import '../styles/utilities.css';

import revealScript from '../scripts/reveal.mjs?url';
import uiScript from '../scripts/ui.mjs?url';
import navbarScrollScript from '../scripts/navbar-scroll.mjs?url';

const {
  title = '',
  desc,
  lang = 'zh',
  pathPrefix = '',
  ogType = 'website',
  ogImage = '/images/og-cover.png',
  noindex = false,
  disableCanonical = false,
  disableLocaleAlternates = false,
  localeAlternates,
} = Astro.props as {
  title?: string;
  desc?: string;
  lang?: 'zh' | 'en';
  pathPrefix?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
  disableLocaleAlternates?: boolean;
  localeAlternates?: LocaleAlternates;
};

const t = lang === 'en' ? siteEn : siteZh;
const description = desc || t.home.intro;
const currentPath = normalizeSitePath(Astro.url.pathname);
const hasExplicitLocaleAlternates = Object.prototype.hasOwnProperty.call(Astro.props, 'localeAlternates');
const resolvedLocaleAlternates = hasExplicitLocaleAlternates ? localeAlternates ?? {} : buildDefaultLocaleAlternates(currentPath);
const zhPath = resolvedLocaleAlternates.zh ? normalizeSitePath(resolvedLocaleAlternates.zh) : undefined;
const enPath = resolvedLocaleAlternates.en ? normalizeSitePath(resolvedLocaleAlternates.en) : undefined;
const xDefaultPath = resolvedLocaleAlternates.xDefault
  ? normalizeSitePath(resolvedLocaleAlternates.xDefault)
  : zhPath || enPath;
const canonicalPath = lang === 'en' ? enPath || currentPath : zhPath || currentPath;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || import.meta.env.SITE_URL || Astro.site;
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const ogImageUrl = toAbsoluteUrl(ogImage, siteUrl);
const localeSwitchHref = disableLocaleAlternates ? undefined : lang === 'zh' ? enPath : zhPath;
const hasAlternateLocale = Boolean(localeSwitchHref);
const localeLabel = lang === 'zh' ? '中文' : 'English';
const alternateLocaleLabel = lang === 'zh' ? 'English' : '中文';
const ogLocale = lang === 'zh' ? 'zh_TW' : 'en_US';
const alternateOgLocale = lang === 'zh' ? 'en_US' : 'zh_TW';
const navPath = {
  home: `${pathPrefix}/`,
  members: `${pathPrefix}/members`,
  papers: `${pathPrefix}/papers`,
  courses: `${pathPrefix}/courses`,
  awards: `${pathPrefix}/awards`,
};
const navPathResolved = {
  home: normalizeSitePath(navPath.home),
  members: normalizeSitePath(navPath.members),
  papers: normalizeSitePath(navPath.papers),
  courses: normalizeSitePath(navPath.courses),
  awards: normalizeSitePath(navPath.awards),
};

const navItems = [
  { href: navPathResolved.home, label: t.nav.home, exact: true, icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1v-9.5Z' },
  { href: navPathResolved.members, label: t.nav.members, exact: false, icon: 'M8.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0 1.5c-3 0-6.5 1.6-6.5 4.5V20h13v-3c0-2.9-3.5-4.5-6.5-4.5Zm8 1.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm.5 1c-1.2 0-2.4.3-3.4.8 2.4 1.1 3.9 3 3.9 5.2V20h6v-2.5c0-2.5-3-3.5-6.5-4.5Z' },
  { href: navPathResolved.papers, label: t.nav.papers, exact: false, icon: 'M12 2a6.5 6.5 0 0 0-6.5 6.5c0 2.3 1.2 4.4 3 5.6V17h7v-2.9c1.8-1.2 3-3.3 3-5.6A6.5 6.5 0 0 0 12 2Zm-2 16.5h4v.5a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-.5Z' },
  { href: navPathResolved.courses, label: t.nav.courses, exact: false, icon: 'M12 2 2 6.5V11h2v-2l8 3.5L22 9V6.5L12 2ZM5 13v6c0 1.1 3.1 2 7 2s7-.9 7-2v-6l-7 3-7-3Z' },
  { href: navPathResolved.awards, label: t.nav.awards, exact: false, icon: 'M5 2h14v3a7 7 0 0 1-6 6.9V15h4v2H7v-2h4v-3.1A7 7 0 0 1 5 5V2Zm2 2v1a5 5 0 0 0 10 0V4H7Z' },
].map((item) => ({
  ...item,
  active: item.exact ? currentPath === item.href : currentPath.startsWith(item.href),
}));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'} class="js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${t.siteName}` : t.siteName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {!disableCanonical && <link rel="canonical" href={canonicalUrl} />}
    {!disableLocaleAlternates && zhPath && <link rel="alternate" hreflang="zh-TW" href={toAbsoluteUrl(zhPath, siteUrl)} />}
    {!disableLocaleAlternates && enPath && <link rel="alternate" hreflang="en" href={toAbsoluteUrl(enPath, siteUrl)} />}
    {!disableLocaleAlternates && xDefaultPath && <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(xDefaultPath, siteUrl)} />}
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta property="og:description" content={description} />
    {!disableCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta property="og:locale" content={ogLocale} />
    {!disableLocaleAlternates && hasAlternateLocale && <meta property="og:locale:alternate" content={alternateOgLocale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <ClientRouter />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-tc-vf.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CoolveticaRg-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/images/dvlab-logo.png" />
    <link rel="apple-touch-icon" href="/images/dvlab-logo.png" />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "DVLab - Design Verification Lab, NTUEE",
        "alternateName": "DVLab",
        "url": "https://dvlab-ntu.github.io/",
        "description": "Design Verification Lab (DVLab) at National Taiwan University, directed by Prof. Chung-Yang (Ric) Huang. Research on formal verification, quantum circuit synthesis and optimization, and electronic design automation.",
        "email": "cyhuang@ntu.edu.tw",
        "parentOrganization": {
          "@type": "CollegeOrUniversity",
          "name": "National Taiwan University"
        }
      }
    </script>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('lab-theme');
        const preferred = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', preferred);
      })();
    </script>
    <noscript>
      <style>
        .js [data-reveal],
        .js [data-list-intro] > [data-list-intro-item][data-list-intro-active] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="page-loader" aria-hidden="true">
      <div class="line-scale">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={navPathResolved.home} aria-label={t.siteName}>
          <img class="brand-logo" src="/images/dvlab-logo.png" alt="DVLab" width="57" height="40" />
        </a>
        <nav class="nav-links" aria-label="Site">
          {navItems.map((item) => (
            <a
              class={`nav-link ${item.active ? 'is-active' : ''}`}
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              <span class="nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
              </span>
              <span class="nav-text">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <button class="btn btn-ghost" data-theme-toggle type="button" aria-label="Switch theme">Dark</button>
        </div>
      </div>
    </header>

    <main class="container site-shell">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <span class="lang-switch">
          {lang === 'zh' ? (
            <>
              <span aria-current="page">{localeLabel}</span>
              {localeSwitchHref && (
                <>
                  {' / '}
                  <a href={localeSwitchHref}>{alternateLocaleLabel}</a>
                </>
              )}
            </>
          ) : (
            <>
              {localeSwitchHref && (
                <>
                  <a href={localeSwitchHref}>{alternateLocaleLabel}</a>
                  {' / '}
                </>
              )}
              <span aria-current="page">{localeLabel}</span>
            </>
          )}
        </span>
        <span class="footer-copy">© 2026 {t.siteName}</span>
        <span>
          <a href="https://github.com/DVLab-NTU/dvlab-ntu.github.io" target="_blank" rel="noreferrer">
            GitHub
          </a>
        </span>
      </div>
    </footer>
    <script type="module" src={revealScript}></script>
    <script type="module" src={uiScript}></script>
    <script type="module" src={navbarScrollScript}></script>
  </body>
</html>
