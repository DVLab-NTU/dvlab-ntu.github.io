---
import siteZh from '../data/site.zh.json';
import siteEn from '../data/site.en.json';
import { buildDefaultLocaleAlternates, normalizeSitePath, toAbsoluteUrl } from '../utils/seo';
import type { LocaleAlternates } from '../utils/seo';

import '../styles/tokens.css';
import '../styles/cra-fonts.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/effects.css';
import '../styles/utilities.css';
import '../styles/cra-layout.css';
import '../styles/glass-ui.css';
import '../styles/cra-typography.css';
import '../styles/page-background.css';

import { resolvePageBackgroundKey } from '../utils/page-background.mjs';
import { lucideNavIcons } from '../data/lucide-icons.mjs';
import LucideIcon from '../components/LucideIcon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import revealScript from '../scripts/reveal.mjs?url';
import uiScript from '../scripts/ui.mjs?url';
import navbarScrollScript from '../scripts/navbar-scroll.mjs?url';

const {
  title = '',
  desc,
  lang = 'zh',
  pathPrefix = '',
  ogType = 'website',
  ogImage = '/images/og-cover.png',
  noindex = false,
  disableCanonical = false,
  disableLocaleAlternates = false,
  localeAlternates,
} = Astro.props as {
  title?: string;
  desc?: string;
  lang?: 'zh' | 'en';
  pathPrefix?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
  disableLocaleAlternates?: boolean;
  localeAlternates?: LocaleAlternates;
};

const t = lang === 'en' ? siteEn : siteZh;
const description = desc || t.home.intro;
const currentPath = normalizeSitePath(Astro.url.pathname);
const hasExplicitLocaleAlternates = Object.prototype.hasOwnProperty.call(Astro.props, 'localeAlternates');
const resolvedLocaleAlternates = hasExplicitLocaleAlternates ? localeAlternates ?? {} : buildDefaultLocaleAlternates(currentPath);
const zhPath = resolvedLocaleAlternates.zh ? normalizeSitePath(resolvedLocaleAlternates.zh) : undefined;
const enPath = resolvedLocaleAlternates.en ? normalizeSitePath(resolvedLocaleAlternates.en) : undefined;
const xDefaultPath = resolvedLocaleAlternates.xDefault
  ? normalizeSitePath(resolvedLocaleAlternates.xDefault)
  : zhPath || enPath;
const canonicalPath = lang === 'en' ? enPath || currentPath : zhPath || currentPath;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || import.meta.env.SITE_URL || Astro.site;
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const ogImageUrl = toAbsoluteUrl(ogImage, siteUrl);
const localeSwitchHref = disableLocaleAlternates ? undefined : lang === 'zh' ? enPath : zhPath;
const hasAlternateLocale = Boolean(localeSwitchHref);
const localeLabel = lang === 'zh' ? '中文' : 'English';
const alternateLocaleLabel = lang === 'zh' ? 'English' : '中文';
const ogLocale = lang === 'zh' ? 'zh_TW' : 'en_US';
const alternateOgLocale = lang === 'zh' ? 'en_US' : 'zh_TW';
const navPath = {
  home: `${pathPrefix}/`,
  host: `${pathPrefix}/host`,
  members: `${pathPrefix}/members`,
  papers: `${pathPrefix}/papers`,
  courses: `${pathPrefix}/courses`,
  awards: `${pathPrefix}/awards`,
};
const navPathResolved = {
  home: normalizeSitePath(navPath.home),
  host: normalizeSitePath(navPath.host),
  members: normalizeSitePath(navPath.members),
  papers: normalizeSitePath(navPath.papers),
  courses: normalizeSitePath(navPath.courses),
  awards: normalizeSitePath(navPath.awards),
};

const pageBgKey = resolvePageBackgroundKey(currentPath);

const navItems = [
  { href: navPathResolved.home, label: t.nav.home, exact: true, iconKey: 'home' },
  { href: navPathResolved.host, label: t.nav.host, exact: false, iconKey: 'host' },
  { href: navPathResolved.members, label: t.nav.members, exact: false, iconKey: 'members' },
  { href: navPathResolved.papers, label: t.nav.papers, exact: false, iconKey: 'papers' },
  { href: navPathResolved.courses, label: t.nav.courses, exact: false, iconKey: 'courses' },
  { href: navPathResolved.awards, label: t.nav.awards, exact: false, iconKey: 'awards' },
].map((item) => ({
  ...item,
  active: item.exact
    ? currentPath === item.href
    : currentPath.startsWith(item.href),
}));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'} class="has-unified-page-backdrop" data-page-bg={pageBgKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${t.siteName}` : t.siteName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {!disableCanonical && <link rel="canonical" href={canonicalUrl} />}
    {!disableLocaleAlternates && zhPath && <link rel="alternate" hreflang="zh-TW" href={toAbsoluteUrl(zhPath, siteUrl)} />}
    {!disableLocaleAlternates && enPath && <link rel="alternate" hreflang="en" href={toAbsoluteUrl(enPath, siteUrl)} />}
    {!disableLocaleAlternates && xDefaultPath && <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(xDefaultPath, siteUrl)} />}
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta property="og:description" content={description} />
    {!disableCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta property="og:locale" content={ogLocale} />
    {!disableLocaleAlternates && hasAlternateLocale && <meta property="og:locale:alternate" content={alternateOgLocale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} · ${t.siteName}` : t.siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- SPA view-transition navigation removed: on this static site every
         route is a full HTML page, so plain full-page navigation switches
         instantly on click (no fetch-then-swap input lag). -->
    <link rel="prefetch" href={`${pathPrefix}/`} />
    <link rel="prefetch" href={`${pathPrefix}/host/`} />
    <link rel="prefetch" href={`${pathPrefix}/members/`} />
    <link rel="prefetch" href={`${pathPrefix}/papers/`} />
    <link rel="prefetch" href={`${pathPrefix}/courses/`} />
    <link rel="prefetch" href={`${pathPrefix}/awards/`} />
    <link rel="icon" type="image/png" href="/images/dvlab-logo.png" />
    <link rel="apple-touch-icon" href="/images/dvlab-logo.png" />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "DVLab - Design Verification Lab, NTUEE",
        "alternateName": "DVLab",
        "url": "https://dvlab.ee.ntu.edu.tw/",
        "description": "Design Verification Lab (DVLab) at National Taiwan University, directed by Prof. Chung-Yang (Ric) Huang. Research on formal verification, quantum circuit synthesis and optimization, and electronic design automation.",
        "email": "cyhuang@ntu.edu.tw",
        "parentOrganization": {
          "@type": "CollegeOrUniversity",
          "name": "National Taiwan University"
        }
      }
    </script>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('lab-theme'); } catch {}
        const preferred = (saved === 'light' || saved === 'dark') ? saved : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', preferred);
      })();
    </script>
    <noscript>
      <style>
        [data-reveal],
        [data-list-intro] > [data-list-intro-item][data-list-intro-active] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
    <style is:inline>
      /* Critical inline styles: applied before the stylesheet loads so full
         page navigations never flash a white background or oversized images.
         Unified-backdrop routes use gradient stops; legacy flat fill is fallback only. */
      html.has-unified-page-backdrop {
        background: #0f1c2b;
      }
      html.has-unified-page-backdrop[data-theme='light'] {
        background: #e0e6d6;
      }
      html:not(.has-unified-page-backdrop) {
        background: #14263a;
      }
      html:not(.has-unified-page-backdrop)[data-theme='light'] {
        background: #f5f8e4;
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body id="top" class:list={['has-unified-page-backdrop', pageBgKey === 'home' && 'is-home-route']}>
    <div class="page-backdrop" aria-hidden="true">
      <div class="page-backdrop__noise"></div>
      <div class="page-backdrop__vignette"></div>
    </div>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={navPathResolved.home} aria-label={t.siteName}>
          <img class="brand-logo brand-logo-dark" src="/images/dvlab-logo.png" alt="DVLab" width="120" height="84" />
          <img class="brand-logo brand-logo-light" src="/images/dvlab-logo-light.png" alt="" aria-hidden="true" width="120" height="84" loading="eager" />
        </a>
        <nav id="site-nav" class="nav-links" aria-label={lang === 'zh' ? '網站導覽' : 'Site'}>
          {navItems.map((item) => (
            <a
              class={`nav-link ${item.active ? 'is-active' : ''}`}
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              <span class="nav-icon">
                <LucideIcon class="nav-lucide-icon" nodes={lucideNavIcons[item.iconKey]} />
              </span>
              <span class="nav-text">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle-btn btn-shine" data-theme-toggle type="button" aria-label="Switch theme">Dark</button>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label={lang === 'zh' ? '開啟選單' : 'Open menu'}
          >
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
          <a class="lang-link btn-shine" href={localeSwitchHref} aria-label={alternateLocaleLabel}>{alternateLocaleLabel}</a>
        </div>
      </div>
    </header>
    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const height = Math.ceil(header.getBoundingClientRect().height);
        document.documentElement.style.setProperty('--site-header-height', `${height}px`);
      })();
    </script>

    <main class="container site-shell cra-site page-shell" data-page-bg={pageBgKey}>
      <div class="page-content">
        <slot />
      </div>
    </main>
    <SiteFooter lang={lang} siteName={t.siteName} />
    <script type="module" src={revealScript}></script>
    <script type="module" src={uiScript}></script>
    <script type="module" src={navbarScrollScript}></script>
  </body>
</html>
